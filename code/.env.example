# IBM Event Streams bootstrap endpoint, typically host:port
KAFKA_BOOTSTRAP_SERVERS=broker.example.cloud.ibm.com:9093
KAFKA_API_KEY=replace_me
KAFKA_TOPIC=bank.transactions
TRANSACTIONS_PER_SECOND=10
FRAUD_PROBABILITY=0.08
SEED=42
# Spark sink
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=fraud
POSTGRES_USER=fraud_app
POSTGRES_PASSWORD=replace_me
SPARK_CHECKPOINT=/tmp/fraud-spark-checkpoint
